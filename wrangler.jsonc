{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "abletonhub",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{ "pattern": "abletonhub.org", "custom_domain": true },
		{ "pattern": "www.abletonhub.org", "custom_domain": true }
	],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
